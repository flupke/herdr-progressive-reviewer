+            path,
+            TargetRanges {
+                old: enclosing_range(selected.iter().filter_map(|hunk| hunk.old.clone())),
+                new: enclosing_range(selected.iter().filter_map(|hunk| hunk.new.clone())),
+            },
+        )
+    }
+
+    fn accept_lines(
+        &mut self,
+        path: &str,
+        old: Option<&GuideLineRange>,
