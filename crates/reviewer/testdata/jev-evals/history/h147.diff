+fn is_response_publication_event(event: &notify::Event) -> bool {
+    if event.need_rescan() {
+        return true;
+    }
+    if matches!(event.kind, notify::EventKind::Access(_)) {
+        return false;
+    }
+    event
+        .paths
+        .iter()
+        .any(|path| path.file_name().is_some_and(|name| name == RESPONSE_FILE))
+}
