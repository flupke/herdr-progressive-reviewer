     /// Record a focused agent event from this workspace.
     fn observe_agent_focus(&mut self, agent: &Agent) {
         if agent.workspace_id == self.workspace_id {
             self.last_agent_pane_id = Some(agent.pane_id.clone());
         }
     }
 
