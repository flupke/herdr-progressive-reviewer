+    /// Queues `reply`, and sends the queue at once when it reached the policy's size cap.
+    pub fn push(&mut self, reply: Reply, now: Instant) {
+        self.waiting.push(reply);
+        self.last_push = Some(now);
+        if self.policy.is_full(self.waiting.len()) {
+            self.flush(FlushReason::Full);
+        }
+    }
+
+    /// Sends the queue when the reviewer has been idle for the policy's delay.
+    pub fn tick(&mut self, now: Instant) {
+        if let Some(last) = self.last_push {
+            if self.policy.is_idle(now.duration_since(last)) {
+                self.flush(FlushReason::Idle);
+            }
+        }
+    }
+
+    /// Sends every waiting reply in one notification, and empties the queue.
+    pub fn flush(&mut self, reason: FlushReason) {
+        if self.waiting.is_empty() {
+            return;
+        }
+        self.link.notify_batch(&self.waiting, reason);
+        self.sent += self.waiting.len();
+        self.waiting.clear();
+        self.last_push = None;
     }
 
