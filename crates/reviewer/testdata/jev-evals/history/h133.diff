+
+fn context_rows(count: u32) -> Vec<DiffRow> {
+    (0..count)
+        .map(|line| DiffRow::Context {
+            old_line: line + 1,
+            new_line: line + 1,
+            text: format!("line {line}"),
+        })
+        .collect()
+}
