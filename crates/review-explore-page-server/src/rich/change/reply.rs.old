use std::time::Instant;

use crate::notify::queue::ReplyQueue;
use crate::threads::{Reply, Thread, ThreadError};

/// Saves the reviewer's reply to its thread, then tells the agent.
pub fn post_reply(
    thread: &mut Thread,
    queue: &mut ReplyQueue,
    text: String,
) -> Result<(), ThreadError> {
    let reply = Reply::new(thread.id(), text);
    thread.append(reply.clone())?;
    queue.push(reply, Instant::now());
    Ok(())
}

/// Closes the pane's threads.
pub fn close_threads(threads: &mut [Thread]) -> Result<(), ThreadError> {
    for thread in threads {
        thread.save()?;
    }
    Ok(())
}
