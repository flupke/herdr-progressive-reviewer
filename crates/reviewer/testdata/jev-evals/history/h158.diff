+            return false;
+        };
+        if first_hunk == 0 || first_hunk > last_hunk || last_hunk > file.hunk_count {
+            return false;
+        }
+        let selected = &file.hunks[first_hunk - 1..last_hunk];
+        accept_non_overlapping(
