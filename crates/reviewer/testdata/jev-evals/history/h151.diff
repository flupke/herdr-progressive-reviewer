     fn hover_key(&mut self, key: Key) -> Action {
         match key {
             Key::Escape => self.hover = None,
             Key::Down | Key::Char('j') => {
                 self.hover_scroll = self.hover_scroll.saturating_add(1);
             }
             Key::Up | Key::Char('k') => {
                 self.hover_scroll = self.hover_scroll.saturating_sub(1);
             }
             _ => {}
         }
         Action::None
     }
 
